#!/bin/sh
# Refuse a push that the tests do not pass: the whole suite, new random sequences, the site build.
# The tests read the working tree, so it must hold exactly the commit a pushed branch points to.
# Run with the Python of the environment the package is installed in, or name it in PYTHON.
set -e
cd "$(git rev-parse --show-toplevel)"
if [ -n "$(git status --porcelain)" ]; then
    echo "pre-push: the working tree differs from the commit; commit or put the changes aside first." >&2
    git status --short >&2
    exit 1
fi
head="$(git rev-parse HEAD)"
# Each line git gives: the local ref, its commit, the remote ref, the remote's commit.
while read -r local_ref local_sha _remote_ref _remote_sha; do
    case "$local_ref" in
        refs/heads/*)
            if [ "$local_sha" != "$head" ] && [ "$local_sha" != 0000000000000000000000000000000000000000 ]; then
                echo "pre-push: $local_ref is not the commit checked out; check it out to push it." >&2
                exit 1
            fi ;;
    esac
done
PYTHON="${PYTHON:-python}"
"$PYTHON" -m pytest -q -p no:cacheprovider -n auto
LLAMA_CHAT_SLOW_EXAMPLES=200 "$PYTHON" -m pytest -q -p no:cacheprovider -m slow tests/test_sequences.py
site="$(mktemp -d)"
trap 'rm -rf "$site"' EXIT
"$PYTHON" -m mkdocs build --strict --quiet --site-dir "$site"
