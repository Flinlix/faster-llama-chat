#!/bin/sh
# Refuse a push that the tests do not pass: the whole suite, new random sequences, the site build.
# The tests read the working tree, so it must hold exactly the commit every pushed ref points to.
# Run with the Python of the environment the package is installed in, or name it in PYTHON.
set -e
cd "$(git rev-parse --show-toplevel)"
if [ -n "$(git status --porcelain)" ]; then
    echo "pre-push: the working tree differs from the commit; commit or put the changes aside first." >&2
    git status --short >&2
    exit 1
fi
head="$(git rev-parse HEAD)"
# Each line git gives: the local ref, its object, the remote ref, the remote's commit. Every
# commit pushed, by branch, tag or hash, is the one checked out; a deletion pushes none.
while read -r local_ref local_sha _remote_ref _remote_sha; do
    [ "$local_sha" = 0000000000000000000000000000000000000000 ] && continue
    if [ "$(git rev-parse "$local_sha^{commit}")" != "$head" ]; then
        echo "pre-push: $local_ref is not the commit checked out; check it out to push it." >&2
        exit 1
    fi
done
PYTHON="${PYTHON:-python}"
"$PYTHON" -m pytest -q -p no:cacheprovider -n auto
LLAMA_CPP_CONVERSATION_SLOW_EXAMPLES=200 "$PYTHON" -m pytest -q -p no:cacheprovider -m slow tests/test_sequences.py
site="$(mktemp -d)"
trap 'rm -rf "$site"' EXIT
"$PYTHON" -m sphinx -W --keep-going -q -b dirhtml docs "$site"
