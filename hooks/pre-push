#!/bin/sh
# Refuse a push that the tests do not pass: the whole suite, then new random sequences.
# Run with the Python of the environment the package is installed in, or name it in PYTHON.
set -e
cd "$(git rev-parse --show-toplevel)"
PYTHON="${PYTHON:-python}"
"$PYTHON" -m pytest -q -p no:cacheprovider -n auto
LLAMA_CHAT_SLOW_EXAMPLES=200 "$PYTHON" -m pytest -q -p no:cacheprovider -m slow tests/test_sequences.py
